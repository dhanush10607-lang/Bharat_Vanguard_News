# ============================================================
# TruthLens AI — .gitignore
# Stack: Python (FastAPI) + Node.js (Next.js) + HuggingFace ML
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.Python
env/
venv/
.venv/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json
.ruff_cache/

# ── Environment & Secrets (NEVER commit these) ─────────────────
.env
.env.local
.env.production
.env.staging
.env.*.local
*.secret
secrets.json
credentials.json

# ── Node.js / Next.js ──────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.js
.yarn/
.vercel/

# ── HuggingFace / ML Models (too large for git, ~GBs) ─────────
# Models are downloaded automatically on first run via the NLP worker
ml/models/
models/
*.bin
*.pt
*.pth
*.onnx
*.safetensors
sentence_transformers_cache/
huggingface_cache/
transformers_cache/

# spaCy model caches
en_core_web_sm/
en_core_web_md/
en_core_web_lg/

# ── Database ───────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ── Alembic ────────────────────────────────────────────────────
# Keep migration scripts, ignore pycache
migrations/versions/__pycache__/

# ── Logs ───────────────────────────────────────────────────────
logs/
*.log
celerybeat-schedule
celerybeat.pid

# ── Testing & Coverage ─────────────────────────────────────────
.coverage
coverage.xml
htmlcov/
.pytest_cache/
test-results/
junit.xml

# ── IDE & OS ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Docker (local dev only) ────────────────────────────────────
.docker/
docker-compose.override.yml

# ── Misc ───────────────────────────────────────────────────────
.cache/
tmp/
temp/
scratch/
*.bak
*.orig

# ── Render / Vercel (local build artifacts) ────────────────────
.render/
.output/

# ── NLTK downloaded data (auto-downloaded on first run) ────────
nltk_data/
