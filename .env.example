APP_ENV=development           # development | production
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-64-chars
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

