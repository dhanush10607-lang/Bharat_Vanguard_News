SUPABASE_URL=https://wtrcmqhvvlipbxmaagsy.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Ind0cmNtcWh2dmxpcGJ4bWFhZ3N5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU1Mjk3MDYsImV4cCI6MjEwMTEwNTcwNn0.sgiETHLiR7SRyLPwsMB8pBA19T3ZR2KIIqGqlOUz1ww
