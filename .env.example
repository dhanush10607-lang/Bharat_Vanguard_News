# -------------------------------------------------------
# REDIS — Upstash Redis (free tier)
# Get from: console.upstash.com → Create Database → REST API
# -------------------------------------------------------
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# -------------------------------------------------------
# NEWS APIs — All Free, No Credit Card
# -------------------------------------------------------

# The Guardian Open Platform (free: 5,000 calls/day)
# Sign up: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=your-guardian-api-key

# Currents API (free: 1,000 req/day)
# Sign up: https://currentsapi.services/en/register
CURRENTS_API_KEY=your-currents-api-key

# NY Times Article Search (free: 500 req/day)
# Sign up: https://developer.nytimes.com/
NYT_API_KEY=your-nyt-api-key

# Hacker News — No key needed (public Firebase API)
HN_API_BASE=https://hacker-news.firebaseio.com/v0

# -------------------------------------------------------
# SEARCH — Bonsai Elasticsearch (free: 125MB)
# Sign up: https://bonsai.io/ → Create free cluster
# -------------------------------------------------------
ELASTICSEARCH_URL=https://[username]:[password]@[host].bonsaisearch.net:443
ELASTICSEARCH_ENABLED=false    # Set true after Bonsai setup

# -------------------------------------------------------
# NLP MODELS — HuggingFace (free, downloaded locally)
# -------------------------------------------------------
HF_CACHE_DIR=./huggingface_cache
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
SUMMARIZATION_MODEL=facebook/bart-large-cnn
TOPIC_MODEL=facebook/bart-large-mnli
SPACY_MODEL=en_core_web_sm

# Similarity threshold for duplicate detection (0.0–1.0)
DUPLICATE_THRESHOLD=0.82

# -------------------------------------------------------
# COLLECTOR SETTINGS
# -------------------------------------------------------
COLLECTOR_INTERVAL_MINUTES=10     # How often to run RSS collector
PARSER_TIMEOUT_SECONDS=30         # Max time to fetch an article
MAX_ARTICLES_PER_RUN=100          # Limit per collector run
REQUEST_DELAY_SECONDS=2           # Polite delay between requests

# -------------------------------------------------------
# JWT AUTH (for email/password sessions)
# -------------------------------------------------------
JWT_SECRET=/OMwub8AQ+2YPd8aSlv6N+IFZ1ld9OKZZ0K66hSx90IKWYOKUKpOyzivh4pr/ZBAoM6VRrU4mFV/Y6JQc/ijFQ==
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080          # 7 days

# -------------------------------------------------------
# GOOGLE OAUTH — via Supabase Auth (free, no extra service)
# Setup steps:
#   1. Go to https://console.cloud.google.com/
#   2. Create a project → APIs & Services → Credentials
#   3. Create OAuth 2.0 Client ID (Web application)
#   4. Add Authorized redirect URI:
#      https://[PROJECT_REF].supabase.co/auth/v1/callback
#   5. Copy Client ID and Secret into Supabase Dashboard:
#      Authentication → Providers → Google → Enable
#   6. Paste Client ID and Secret below (for backend verification)
# -------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Supabase Auth settings (used for OAuth token verification)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret   # From: Supabase → Settings → API → JWT Secret

# URL to redirect user to after Google login (your frontend)
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# -------------------------------------------------------
# FRONTEND (Next.js)
# Prefix with NEXT_PUBLIC_ to expose to browser
# -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="TruthLens AI"
NEXT_PUBLIC_APP_DESCRIPTION="AI-powered news intelligence platform"

# -------------------------------------------------------
# MONITORING & ERROR TRACKING
# -------------------------------------------------------
SENTRY_DSN=                       # Leave blank until needed
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
